# ==============================================================================
# Meeting Insights Studio — Environment Variables Example
# Copy this file to `envs/.env` or `.env` and insert your credentials.
# ==============================================================================

# 1. API Keys & Endpoints
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# 2. Configured Models
MODEL_TRANSCRIBE_DIARIZE=gpt-4o-transcribe-diarize
MODEL_EMBEDDING=text-embedding-3-small
MODEL_CHAT_ANALYSIS=gpt-4.1-mini

# 3. Application Server Settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
