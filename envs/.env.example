# Meeting Studio — Environment Configuration
# Place your API keys and model configurations here.

# ==============================================================================
# 1. OpenAI API Credentials
# ==============================================================================
# Add your secret API key below (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI compatible base URL (e.g. Azure OpenAI, local proxy, etc.)
OPENAI_BASE_URL=

# ==============================================================================
# 2. Configured Models (The 3 Core Models)
# ==============================================================================
# Model 1: Audio Transcription & Speaker Diarization
# Used for converting audio/video into timestamped speaker-attributed transcript segments
MODEL_TRANSCRIBE_DIARIZE=gpt-4o-transcribe-diarize

# Model 2: Dense Semantic Embeddings for RAG
# Used for vectorizing transcript chunks and high-accuracy similarity retrieval
MODEL_EMBEDDING=text-embedding-3-small

# Model 3: Reasoning, Summarization, Decisions, Tasks & Chat
# Used for meeting intelligence, TL;DR, action item extraction, critic verification, and Q&A
MODEL_CHAT_ANALYSIS=gpt-4.1-mini

# ==============================================================================
# 3. Application Server Settings
# ==============================================================================
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True
FLASK_SECRET_KEY=meeting-studio-secret-key-2026-openai-rag
